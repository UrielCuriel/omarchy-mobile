# SPDX-License-Identifier: MIT
# OnePlus 10 Pro (wly): kernel options on top of kernel/configs/omamobile.config.
#
# The USB 2.0 PHY's driver, built in: the first-light initramfs loads no
# modules, and without it dwc3-qcom defers forever ("failed to register
# DWC3 Core"), so the gadget never appears.
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# The PMK8350 power-on block, built in for the same reason: it populates the
# power key and RESIN (volume up) nodes, which as a module never appeared
# (only gpio-keys' volume down did), and it carries the reboot reason that
# lets `reboot-to bootloader` reach fastboot without the buttons.
CONFIG_POWER_RESET_QCOM_PON=y

# The reboot reason ABL reads: pmk8350.dtsi's nvmem-reboot-mode writes it to
# SDAM 0x7100 offset 0x48 (bits 1-7, bootloader 0x02), the cell stock's
# qcom,reboot-reason uses too. As modules neither driver loaded, so only
# qcom-pon's reboot-mode ran, writing a PON register ABL does not read, and
# `reboot-to bootloader` came back up in Android.
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_NVMEM_REBOOT_MODE=y

# The PMK8350's RTC and ADC (battery and charger voltages, die and charger
# temperatures), built in like everything else the first light uses.
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_QCOM_SPMI_ADC5=y

# The display: the display clock controller, the MSM DRM driver (DPU, DSI
# and its 7nm PHY) and the panel, all built in so the panel comes up from
# the initramfs. As modules, dispcc also left rpmhpd's sync_state waiting.
CONFIG_SM_DISPCC_8450=y
CONFIG_DRM_MSM=y
# DRM_MSM can only be built in when these are: it depends on them being
# either built in or off, and the base config builds them as modules.
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_PANEL_SAMSUNG_S6E3HC3_AMB670YF07=y

# The touchscreen: the S3908 sits on QUP SE4's I2C bus, which the GENI I2C
# driver runs, with GPI DMA when the QUP firmware puts the bus in GSI mode.
# The TouchComm driver (SPI and I2C) is built in by the base config.
CONFIG_I2C_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y

# Wi-Fi: the QCA6490 (WCN6855) on PCIe0, run by ath11k over MHI and QRTR,
# powered up by the WCN power sequencer through the PCI pwrctrl driver.
# All built in for the first-light initramfs; its firmware is copied in at
# run time, since vendor firmware never goes into these repositories.
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_PCIE=y
CONFIG_POWER_SEQUENCING_QCOM_WCN=y
CONFIG_PCI_PWRCTRL_PWRSEQ=y
CONFIG_MHI_BUS=y
CONFIG_QRTR=y
CONFIG_QRTR_MHI=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y

# Bluetooth: the same QCA6490 (WCN6855), on QUP SE20's UART, run by
# hci_qca. Its firmware, like Wi-Fi's, is added at run time.
CONFIG_BT=y
CONFIG_BT_HCIUART=y
CONFIG_BT_QCA=y

# UFS, read-only: the Qualcomm UFS host and its QMP PHY, built in. The
# initramfs's storage guard sets every partition read-only as it appears
# (INITRAMFS_UFS_READ_ONLY=yes in device.conf: no write allowlist at all).
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y

# The GPU (Adreno 730): its clock controller, which its SMMU and the GPU
# wait for. The msm driver is already built in. Its firmware (SQE, GMU and
# the OEM-signed zap shader) is added at run time like the others.
CONFIG_SM_GPUCC_8450=y

# The SoC's serial number (/sys/devices/soc0/serial_number), which
# omamobile-radio-addr derives the Wi-Fi and Bluetooth addresses from
CONFIG_QCOM_SOCINFO=y

# The alert slider: its I2C bus (QUP SE9) and the MXM1120 Hall sensors
CONFIG_INPUT_ONEPLUS_ALERT_SLIDER=y

# The ADSP (stock's OEM-signed firmware, added at run time) and its battery
# manager through pmic_glink: remoteproc, GLINK, QRTR, the in-kernel PD
# mapper. Not pmic_glink's USB-C clients (UCSI, altmode): USB stays a
# fixed peripheral.
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_PD_MAPPER=y
CONFIG_TYPEC=y
CONFIG_QCOM_PMIC_GLINK=y
CONFIG_BATTERY_QCOM_BATTMGR=y

# USB 3 SuperSpeed: the QMP USB3/DP combo PHY (a module the initramfs never
# loads).
CONFIG_PHY_QCOM_QMP_COMBO=y

# A USB-C hub on the phone, in host mode: its Ethernet is an ASIX AX88179A,
# which Linux drives as CDC NCM (the chip's second configuration);
# ax88179_178a covers the older AX88179. Its card reader (Genesys GL3224) is
# plain USB mass storage, already built in.
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_AX88179_178A=y

# USB-C roles: the ADSP runs the Type-C/PD port and reports it over
# pmic_glink as a UCSI interface. Without UCSI it neither sources VBUS to a
# hub nor lets the controller be host (tested with a hub: dead in a fixed
# host mode, working on stock Android); with it, the connector's role
# switch sets the controller's role.
CONFIG_TYPEC_UCSI=y
CONFIG_UCSI_PMIC_GLINK=y

# OnePlus's OTG handshake with the ADSP (drivers/power/supply/oplus-otg-glink.c,
# our own): without it the ADSP never reports a USB device in the USB-C port.
CONFIG_OPLUS_OTG_GLINK=y

# DisplayPort over USB-C: the FSA4480 switches the SBU lines (DP AUX) for
# pmic_glink_altmode; a module the initramfs would never load.
CONFIG_TYPEC_MUX_FSA4480=y
