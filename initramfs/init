#!/bin/sh
# SPDX-License-Identifier: MIT
# Shared first-light init. One script for every device.
# The only display-register writes are the pairs in /etc/omamobile-simplefb-trig,
# which bin/omamobile initramfs installs from SIMPLEFB_TRIG_CON. The init
# writes each pair only when the board's first compatible string matches
# /etc/omamobile-compatible, the descriptor's COMPATIBLE packed beside it.
# No trigger file, or a different board, means no write. The bring-up probe
# uses that same check, so a cheetah image does not read every DPP elsewhere.
# Host side: the phone appears as a USB network adapter; ssh root@172.16.42.1

export PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts && mount -t devpts devpts /dev/pts
mount -t configfs configfs /sys/kernel/config
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run

# With "splash" on the command line, Plymouth shows the boot animation once
# Arch starts, so keep status lines off the screen (they still go to kmsg).
# Storage-guard warnings always show.
SCREEN=/dev/tty0
if grep -qw splash /proc/cmdline; then
  SCREEN=/dev/null
  # Replace the bootloader's logo with Omarchy's at once; Plymouth draws the
  # same screen when Arch starts, so the two join up. With the descriptor's
  # INITRAMFS_FB_WAIT (raven: simpledrm's fb0 appears only once the PMIC
  # module loaded below gives it its rails), wait for fb0 in the background.
  if [ -f /etc/omamobile-fb-wait ]; then
    [ -f /splash.bgra.gz ] && (
      for _ in $(seq 1 60); do [ -e /dev/fb0 ] && break; sleep 0.05; done
      zcat /splash.bgra.gz > /dev/fb0 2>/dev/null ) &
  else
    [ -f /splash.bgra.gz ] && zcat /splash.bgra.gz > /dev/fb0 2>/dev/null
  fi
fi

# --- UFS safety: every SCSI disk is read-only, before anything else runs ---
# The UFS device holds irreplaceable per-device calibration (efs, persist,
# modem_userdata). Until UFS support is trusted, mark every /dev/sd* disk and
# partition read-only as soon as it appears, and never mount anything. The
# driver is built in, so disks can exist before init starts or show up while
# it runs: do one pass now, then keep a watcher running for the life of PID 1.
# Nothing in this initramfs runs mdev/udev, so no one else touches the disks.
ufs_ro_log() { echo "omamobile: ufs-ro: $*" > /dev/kmsg; }
# Storage guard. Everything on the UFS is read-only except an allowlist of
# partitions we own: slot B's boot images (in-place kernel updates) and
# userdata (the Arch root). The kernel only lets a partition be written if
# its whole disk is writable too, so the main disk (sda) stays writable but
# its whole-disk node is removed, so nothing can write across partitions by
# accident; a LUN the descriptor's UFS_RW_LUNS names is guarded the same way.
# The other LUNs (on Pixels sdb, sdc, sdd: bootloader images) are read-only
# at the disk level. Calibration partitions (efs, persist, modem_userdata...)
# and all of slot A stay read-only.
# The allowlist is the descriptor's UFS_RW, which bin/omamobile initramfs
# checks and packs into /etc/omamobile-ufs-rw. It fails closed: a missing,
# empty or malformed file leaves every partition read-only, so Arch does not
# start and the initramfs shell stays up over SSH. Whatever the file says,
# only slot B's boot images and userdata can be named.
UFS_RW=""
UFS_RW_LUNS=""
# Is $1 a disk that holds allowlisted partitions? sda always.
ufs_rw_disk() { case " sda $UFS_RW_LUNS " in *" $1 "*) true ;; *) false ;; esac; }
# The root is not on UFS (an NFS root, or an external one on USB): every UFS
# partition read-only, the allowlist unused.
ufs_all_ro() { [ -s /etc/omamobile-nfsroot ] || [ -s /etc/omamobile-extroot ]; }
ufs_rw_load() {
  local list p
  if [ -s /etc/omamobile-nfsroot ]; then
    ufs_ro_log "NFS root requested: every UFS partition read-only"
    return 0
  fi
  if [ -s /etc/omamobile-extroot ]; then
    ufs_ro_log "external root requested: every UFS partition read-only"
    return 0
  fi
  if [ ! -s /etc/omamobile-ufs-rw ]; then
    ufs_ro_log "no allowlist in this image (/etc/omamobile-ufs-rw): every partition read-only"
    return 0
  fi
  list=$(cat /etc/omamobile-ufs-rw)
  # One line of lower-case names and spaces; this also rules out globs below
  case "$list" in
    *[!a-z0-9_\ ]*)
      ufs_ro_log "malformed allowlist in /etc/omamobile-ufs-rw: every partition read-only"
      return 0 ;;
  esac
  # shellcheck disable=SC2086 # split into names on purpose
  set -- $list
  if [ $# = 0 ]; then
    ufs_ro_log "empty allowlist in /etc/omamobile-ufs-rw: every partition read-only"
    return 0
  fi
  for p in "$@"; do
    case "$p" in
      boot_b|init_boot_b|vendor_boot_b|vendor_kernel_boot_b|dtbo_b|userdata) ;;
      *)
        ufs_ro_log "allowlist names $p, which is never writable: every partition read-only"
        return 0 ;;
    esac
  done
  UFS_RW="$*"
  ufs_ro_log "allowlist: $UFS_RW"
  # LUNs besides sda that hold allowlisted partitions (the descriptor's
  # UFS_RW_LUNS: enchilada's boot_b is on sde). Each is guarded as sda is.
  # Malformed: none, so their partitions stay read-only.
  [ -s /etc/omamobile-ufs-rw-luns ] || return 0
  list=$(cat /etc/omamobile-ufs-rw-luns)
  # shellcheck disable=SC2086 # split into names on purpose
  case "$list" in *[!a-z\ ]*) set -- bad ;; *) set -- $list ;; esac
  for p in "$@"; do
    case "$p" in
      sd[b-z]) ;;
      *)
        ufs_ro_log "malformed LUN list in /etc/omamobile-ufs-rw-luns: every LUN but sda read-only"
        return 0 ;;
    esac
  done
  UFS_RW_LUNS="$*"
  ufs_ro_log "LUNs with allowlisted partitions: sda $UFS_RW_LUNS"
}
ufs_rw_load
mkdir -p /run/ufs-ro
ufs_partname() { sed -n 's/^PARTNAME=//p' "$1/uevent" 2>/dev/null; }
# ufs_seq SYSFS_PATH: set $seq to the disk's diskseq, which the kernel never
# reuses for a new instance of a disk (a partition takes its disk's). The
# guard keys its "done" marks on it, so a disk that goes and comes back
# under the same name (a USB drive replugged) is guarded again. Empty
# without diskseq (older kernels): the marks then match as before.
ufs_seq() {
  seq=
  if [ -r "$1/diskseq" ]; then read -r seq < "$1/diskseq"
  elif [ -r "${1%/*}/diskseq" ]; then read -r seq < "${1%/*}/diskseq"
  fi 2>/dev/null
}
# External root (/etc/omamobile-extroot, local bring-up only): one ext4 label.
# On a disk behind a USB host controller -- never the phone's UFS -- the
# partition carrying exactly that label is left writable, and its disk's
# whole-disk node is removed, as sda's is; everything else is guarded as
# usual. Its mark, /run/ufs-ro/ext-<name>, holds the disk's diskseq.
ufs_usb_disk() {
  case "$(readlink -f "/sys/block/${1%%[0-9]*}")" in */usb[0-9]*) return 0 ;; esac
  return 1
}
ufs_ext_label() { dumpe2fs -h "$1" 2>/dev/null | sed -n 's/^Filesystem volume name: *//p'; }
ufs_extroot_marked() { # SYSFS_PATH NAME: guarded as the external root this instance
  local seq mark
  [ -s /etc/omamobile-extroot ] && [ -e "/run/ufs-ro/ext-$2" ] || return 1
  ufs_seq "$1"
  mark=; read -r mark 2>/dev/null < "/run/ufs-ro/ext-$2"
  [ "$mark" = "$seq" ]
}
ufs_extroot_pass() { # SYSFS_PATH NAME: 0 if handled here (left writable or waiting)
  local want p found= mark
  [ -s /etc/omamobile-extroot ] || return 1
  ufs_usb_disk "$2" || return 1
  read -r want < /etc/omamobile-extroot
  case "$want" in ''|*[!a-z0-9-]*) return 1 ;; esac
  if [ "$2" = "${2%%[0-9]*}" ]; then
    # A whole disk: left writable only if one of its partitions is the root
    local parts=
    for p in "$1"/"$2"*; do
      [ -e "$p/ro" ] || continue
      parts=1
      [ -b "/dev/${p##*/}" ] || return 0  # partition node not there yet: next pass
      [ "$(ufs_ext_label "/dev/${p##*/}")" = "$want" ] && found=1
    done
    if [ -z "$parts" ]; then
      # The kernel adds a disk before its partitions: give them up to 15 s,
      # then guard a disk that still shows none as usual
      local now first
      ufs_seq "$1"
      now=$(cut -d. -f1 /proc/uptime)
      first=; read -r mark first 2>/dev/null < "/run/ufs-ro/pend-$2"
      if [ "$mark" != "$seq" ] || [ -z "$first" ]; then
        echo "$seq $now" > "/run/ufs-ro/pend-$2"; return 0
      fi
      [ $((now - first)) -lt 15 ] && return 0
      return 1
    fi
    [ -n "$found" ] || return 1
    rm -f "/dev/$2"
    ufs_seq "$1"
    echo "$seq" > "/run/ufs-ro/$2"; echo "$seq" > "/run/ufs-ro/ext-$2"
    ufs_ro_log "/dev/$2: whole-disk node removed (external root's disk)"
    return 0
  fi
  [ "$(ufs_ext_label "/dev/$2")" = "$want" ] || return 1
  ufs_seq "$1"
  echo "$seq" > "/run/ufs-ro/$2"; echo "$seq" > "/run/ufs-ro/ext-$2"
  ufs_ro_log "/dev/$2 left writable (external root, label $want)"
  return 0
}
ufs_ro_pass() {
  local s ro name part disk seq mark
  for s in /sys/block/sd* /sys/block/sd*/sd*; do
    [ -r "$s/ro" ] || continue
    name=${s##*/}
    ufs_seq "$s"
    if [ -e "/run/ufs-ro/$name" ]; then
      mark=; read -r mark 2>/dev/null < "/run/ufs-ro/$name"
      [ "$mark" = "$seq" ] && continue
    fi
    [ -b "/dev/$name" ] || continue  # devtmpfs node not there yet: next pass
    if ufs_extroot_pass "$s" "$name"; then
      continue
    fi
    if ufs_rw_disk "$name"; then
      if ufs_all_ro; then
        blockdev --setro "/dev/$name"
        read -r ro < "$s/ro"
        if [ "$ro" = 1 ]; then
          echo "$seq" > "/run/ufs-ro/$name"
          ufs_ro_log "/dev/$name set read-only (root not on UFS)"
          continue
        fi
        ufs_ro_log "FAILED to set /dev/$name read-only for NFS root"
        echo "omamobile: WARNING: /dev/$name is NOT read-only" > /dev/tty0 2>/dev/null
        continue
      fi
      rm -f "/dev/$name"
      echo "$seq" > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/$name: whole-disk node removed (partitions guarded individually)"
      continue
    fi
    part=$(ufs_partname "$s")
    if [ -n "$part" ] && ufs_rw_disk "${name%%[0-9]*}" && \
       case " $UFS_RW " in *" $part "*) true ;; *) false ;; esac; then
      echo "$seq" > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/$name ($part) left writable (allowlist)"
      continue
    fi
    blockdev --setro "/dev/$name"
    read -r ro < "$s/ro"
    if [ "$ro" = 1 ]; then
      echo "$seq" > "/run/ufs-ro/$name"
      ufs_ro_log "/dev/$name${part:+ ($part)} set read-only"
    else
      if [ -e "/run/ufs-ro/$name.failed" ]; then
        mark=; read -r mark 2>/dev/null < "/run/ufs-ro/$name.failed"
        [ "$mark" = "$seq" ] && continue
      fi
      echo "$seq" > "/run/ufs-ro/$name.failed"  # keep retrying, but log once per disk
      ufs_ro_log "FAILED to set /dev/$name read-only"
      echo "omamobile: WARNING: /dev/$name is NOT read-only" > /dev/tty0 2>/dev/null
    fi
  done
}
# Prints every disk or partition that is writable but not on the allowlist
# (sda itself excepted: its node is removed). Empty means the guard holds.
ufs_unguarded() {
  local s name part ro size
  for s in /sys/block/sd* /sys/block/sd*/sd*; do
    [ -r "$s/ro" ] || continue
    name=${s##*/}
    ufs_rw_disk "$name" && ! ufs_all_ro && continue
    ufs_extroot_marked "$s" "$name" && continue
    # No medium (an empty card-reader slot: size 0, and setro fails on it):
    # nothing on it can be written
    size=; read -r size 2>/dev/null < "$s/size"
    [ "$size" = 0 ] && continue
    read -r ro < "$s/ro"
    [ "$ro" = 0 ] || continue
    part=$(ufs_partname "$s")
    if [ -n "$part" ] && ufs_rw_disk "${name%%[0-9]*}"; then
      case " $UFS_RW " in *" $part "*) continue ;; esac
    fi
    echo "$name${part:+ ($part)}"
  done
}
ufs_ro_start() {
  ( while true; do ufs_ro_pass; sleep 0.2 2>/dev/null || sleep 1; done ) &
  ufs_guard_pid=$!
  ufs_ro_log "guard running (pid $ufs_guard_pid)"
}
ufs_ro_pass
ufs_ro_start

hostname omamobile

say() { echo "omamobile: $*" | tee /dev/kmsg > $SCREEN 2>/dev/null; }

# Return 0 when this image was packed for the board that is running.
# $1 names the step in the skip line. A missing or different COMPATIBLE
# skips the step, so a cheetah image cannot touch a Fold.
board_matches() {
  local what=$1 want got
  if [ ! -s /etc/omamobile-compatible ]; then
    say "$what skipped: image has no board compatible"
    return 1
  fi
  read -r want < /etc/omamobile-compatible
  got=$(tr '\0' '\n' < /proc/device-tree/compatible | head -n 1)
  if [ "$got" != "$want" ]; then
    say "$what skipped: board is ${got:-unknown}, image is $want"
    return 1
  fi
  return 0
}

# Modules this image carries (the descriptor's INITRAMFS_MODULES), loaded
# in the packed order before any other step: on raven the PMIC regulator
# driver the simple-framebuffer waits for, and the MAX77759 nvmem that ABL
# reads the reboot reason from. They were built for this image's board.
load_modules() {
  local m error
  [ -s /lib/modules/omamobile/order ] || return 0
  board_matches "initramfs modules" || return 0
  # BusyBox insmod may retry initialization after finit_module fails.
  # These modules can already have touched hardware before returning an error.
  while read -r m; do
    error=$(/usr/local/bin/module-load-once "/lib/modules/omamobile/$m.ko" 2>&1) || say "module-load-once $m failed: $error"
  done < /lib/modules/omamobile/order
}
load_modules

# Command-mode panels take a new frame only when their DECON sends one.
# ABL masks that trigger after the logo. The descriptor's SIMPLEFB_TRIG_CON
# is one pair per line for this phone (TRIG_CON: clear HW_TRIG_MASK_DECON,
# set HW_TRIG_EN). devmem's second argument is the value, not a width.
# Stopgap until a real DECON/DSI driver.
simplefb_trigger() {
  local trig_addr trig_val
  [ -s /etc/omamobile-simplefb-trig ] || return 0
  board_matches "simplefb trigger" || return 0
  while read -r trig_addr trig_val; do
    [ -n "$trig_addr" ] || continue
    devmem "$trig_addr" "$trig_val" >/dev/null || say "simplefb trigger failed"
  done < /etc/omamobile-simplefb-trig
}
simplefb_trigger

clear > $SCREEN 2>/dev/null

# Bring-up probes: watchdog control registers, and the buffer address each
# display DMA channel (DPP) is scanning out, i.e. where ABL's framebuffer is.
# The packer installs the marker only when the descriptor sets BRINGUP_PROBE=1.
# The reads cover every DPP, so they also require this image's board.
probe() {
  {
    for w in 0x10060000 0x10070000; do echo "wtcon $w $(devmem $w)"; done
    for n in 0 1 2 3 4 5 8 9 c; do
      b=$((0x1c0b0000 + 0x$n * 0x1000))
      echo "dpp$n cfg $(devmem $b) base $(devmem $((b + 0x40))) $(devmem $((b + 0x44)))"
    done
  } > /run/probe.txt 2>&1
  while read -r line; do echo "omamobile: $line" > /dev/kmsg; done < /run/probe.txt
}
maybe_probe() {
  [ -f /etc/omamobile-bringup-probe ] || return 0
  board_matches "bring-up probe" || return 0
  probe
}
maybe_probe
say "first light on $(cat /proc/sys/kernel/osrelease)"

# The gadget's product string: the descriptor's USB_PRODUCT, or its NAME,
# which bin/omamobile initramfs packs into /etc/omamobile-usb-product.
usb_product() {
  local product=""
  [ -s /etc/omamobile-usb-product ] && read -r product < /etc/omamobile-usb-product
  echo "${product:-Omarchy Mobile}"
}

# USB gadget: CDC NCM network + ACM serial console
g=/sys/kernel/config/usb_gadget/g1
mkdir -p $g/strings/0x409 $g/configs/c.1/strings/0x409
echo 0x1d6b > $g/idVendor          # Linux Foundation
echo 0x0104 > $g/idProduct         # Multifunction composite gadget
echo "Omarchy Mobile" > $g/strings/0x409/manufacturer
usb_product > $g/strings/0x409/product
echo "omamobile" > $g/strings/0x409/serialnumber
echo "NCM + ACM" > $g/configs/c.1/strings/0x409/configuration
mkdir -p $g/functions/ncm.usb0 $g/functions/acm.GS0
ln -s $g/functions/ncm.usb0 $g/configs/c.1/
ln -s $g/functions/acm.GS0 $g/configs/c.1/

udc=""
for i in $(seq 1 30); do
  udc=$(ls /sys/class/udc 2>/dev/null | head -1)
  [ -n "$udc" ] && break
  sleep 1
done
if [ -n "$udc" ]; then
  echo "$udc" > $g/UDC && say "USB gadget up on $udc"
else
  say "no USB device controller found"
fi

# The MAX77759's Type-C side can leave its USB2 data switch (TCPC vendor
# register USBSW_CTRL, 0x93) open, and no Type-C driver runs here to close
# it: the gadget is up but the host never sees it. The descriptor's
# USB_SWITCH names the TCPC's I2C controller and address; put the register
# back to 0x09 (D+/D- connected), as cheetah's omamobile-usb-rescue does on
# the same chip. Only ever reads that one register and writes that one value,
# and skips the write when it already reads 0x09, the value it holds
# whenever the link works (USB-C-PLAN.md). No dead-man switch is possible
# this early; if USB still doesn't come up, the write changed nothing else.
usb_switch() {
  local ctl addr d bus="" sw i quiet=${1:-}
  read -r ctl addr < /etc/omamobile-usb-switch
  for i in $(seq 1 10); do
    for d in /sys/bus/i2c/devices/i2c-*; do
      readlink -f "$d" | grep -q "/$ctl/" && bus=${d##*-}
    done
    [ -n "$bus" ] && break
    sleep 1
  done
  [ -n "$bus" ] || { say "usb switch: no I2C bus for $ctl"; return; }
  sw=$(i2cget -f -y "$bus" "$addr" 0x93 2>&1)
  [ -n "$quiet" ] && [ "$sw" = 0x09 ] && return
  say "usb switch: USBSW_CTRL on i2c-$bus is $sw"
  case $sw in
    0x09) ;;
    0x*) i2cset -f -y "$bus" "$addr" 0x93 0x09
         say "usb switch: closed, now $(i2cget -f -y "$bus" "$addr" 0x93 2>&1)" ;;
  esac
}
maybe_usb_switch() {
  [ -s /etc/omamobile-usb-switch ] || return 0
  board_matches "usb switch" || return 0
  usb_switch
  # Keep it closed across replugs (it opens on unplug), as cheetah's rescue does
  ( while sleep 2; do usb_switch quiet; done ) &
}
maybe_usb_switch

# Network: phone is 172.16.42.1. The host sets 172.16.42.2/24 itself
# (CONTRIBUTING.md section 2): Alpine's busybox has no udhcpd applet.
ip link set lo up
for i in $(seq 1 10); do ip link show usb0 >/dev/null 2>&1 && break; sleep 1; done
ip addr add 172.16.42.1/24 dev usb0 && ip link set usb0 up

# ssh with the developer's key, and a root shell on the USB serial port
mkdir -p /etc/dropbear
dropbear -R -E -p 22 2>/dev/null && say "ssh: root@172.16.42.1"
( while true; do setsid getty -n -l /bin/sh 115200 ttyGS0 vt100; sleep 1; done ) &

# Wi-Fi rescue link for local bring-up, so ssh survives losing USB (testing
# USB roles, replugging the cable). Only with omamobile.initramfs or an
# external root requested (a hub makes the phone the USB host, so a failed
# external root would leave no other way in), and only when the image
# carries /etc/omamobile-wifi/wpa_supplicant.conf and
# /etc/omamobile-wifi/address (one "ip/prefix" line). Nothing in this
# repository packs them: the network's key belongs to the developer, who
# appends them as a cpio of their own. No files, no change.
wifi_rescue() {
  local conf=/etc/omamobile-wifi/wpa_supplicant.conf
  grep -q omamobile.initramfs /proc/cmdline || [ -s /etc/omamobile-extroot ] || return 0
  [ -s $conf ] && [ -s /etc/omamobile-wifi/address ] || return 0
  command -v wpa_supplicant >/dev/null || {
    say "wifi: no wpa_supplicant (INITRAMFS_RADIO_TOOLS=1)"; return 0; }
  (
    # wlan0 appears once the chip has booted its firmware
    for i in $(seq 1 90); do [ -e /sys/class/net/wlan0 ] && break; sleep 1; done
    [ -e /sys/class/net/wlan0 ] || { say "wifi: no wlan0"; exit 0; }
    command -v omamobile-radio-addr >/dev/null && omamobile-radio-addr wlan0 >/dev/null 2>&1
    ip link set wlan0 up
    wpa_supplicant -B -i wlan0 -c $conf -P /run/wpa_supplicant.pid >/dev/null 2>&1 ||
      { say "wifi: wpa_supplicant failed"; exit 0; }
    ip addr add "$(cat /etc/omamobile-wifi/address)" dev wlan0 &&
      say "wifi: rescue link, ssh root@$(cut -d/ -f1 /etc/omamobile-wifi/address)"
  ) &
}
wifi_rescue

# Bring-up diagnostics on screen when the cmdline has omamobile.debug: USB log
# lines, whether interrupts arrive, and what the bootloader passed in.
grep -q omamobile.debug /proc/cmdline && {
  echo "--- usb/phy/dwc3 ---"
  dmesg | grep -iE 'dwc3|phy|udc|gadget|11210000|pmu' | tail -14
  echo "--- interrupts (timer, usb) at two points ---"
  grep -iE 'arch_timer|dwc3|11210000' /proc/interrupts | cut -c1-90
  i=0; while [ $i -lt 300000 ]; do i=$((i+1)); done
  grep -iE 'arch_timer|dwc3|11210000' /proc/interrupts | cut -c1-90
  echo "--- uptime $(cut -d' ' -f1 /proc/uptime), udc $(cat /sys/class/udc/*/state 2>/dev/null) ---"
  echo "--- cmdline tail ---"
  tr ' ' '\n' < /proc/cmdline | tail -12 | tr '\n' ' '
  echo
} > $SCREEN 2>&1

# UFS probe report when the cmdline has omamobile.ufs-probe: wait for the
# disks to settle, then list them and the GPT partition names. Read-only: it
# only reads /proc and sysfs, after the guard above has marked the disks ro.
grep -q omamobile.ufs-probe /proc/cmdline && (
  last=-1
  for i in $(seq 1 30); do
    n=$(ls -d /sys/block/sd*/sd* 2>/dev/null | wc -l)
    [ "$n" -gt 0 ] && [ "$n" = "$last" ] && break
    last=$n
    sleep 1
  done
  ufs_ro_pass
  {
    echo "=== ufs-probe: $(ls -d /sys/block/sd* 2>/dev/null | wc -l) disks, $n partitions ==="
    cat /proc/partitions
    for d in /sys/block/sd*; do
      [ -e "$d" ] || { echo "no /sys/block/sd* (UFS did not enumerate)"; break; }
      echo "${d##*/}: ro=$(cat "$d/ro") size=$(cat "$d/size") model=$(cat "$d/device/model" 2>/dev/null)"
      for p in "$d"/sd*; do
        [ -e "$p/uevent" ] || continue
        echo "  ${p##*/} ro=$(cat "$p/ro") $(grep '^PARTNAME=' "$p/uevent")"
      done
    done
    echo "=== ufs-probe: dmesg ==="
    dmesg | grep -iE 'ufs|scsi|sd[a-z]|14700000' | tail -25
  } > /run/ufs-probe.txt 2>&1
  cat /run/ufs-probe.txt > $SCREEN 2>/dev/null
  while read -r line; do echo "omamobile: $line" > /dev/kmsg; done < /run/ufs-probe.txt
) &

say "ready"

# Self-recovery for bring-up: if the host never configures the USB gadget,
# show why on screen, then crash so the phone falls back to stock Android.
if [ "$(cat /etc/omamobile-usb-recovery 2>/dev/null)" != no ]; then
(
  for i in $(seq 1 45); do
    grep -qx configured /sys/class/udc/*/state 2>/dev/null && exit 0
    sleep 1
  done
  {
    echo
    echo "=== USB never configured; dmesg follows ==="
    dmesg | grep -iE 'dwc3|phy|usb|udc|clk|error|fail' | tail -30
    echo "omamobile: no USB host, crashing in 20 s so ABL falls back to slot A"
  } > $SCREEN
  sleep 20
  # Never in the middle of growing the root file system (boot_arch)
  while [ -e /run/omamobile-resizing ]; do sleep 1; done
  sync
  # reboot-to bootloader is unreliable; a panic (panic=10) reboots, and once
  # slot B is out of retries ABL boots stock Android, which adb can reach
  echo c > /proc/sysrq-trigger
) &
fi





# First boot of a flashed root image (tools/install-phone): the image is a
# few GB, so grow its file system to the whole userdata partition before
# mounting it. Only an Omarchy Mobile root (label omamobile-root) that is
# more than 64 MiB smaller than its partition, so it happens once; a root
# installed any other way is left alone. omamobile.noresize skips it.
grow_root() {
  local dev=$1 info part_bytes fs_bytes blocks bsize
  grep -q omamobile.noresize /proc/cmdline && return 0
  info=$(dumpe2fs -h "$dev" 2>/dev/null)
  [ "$(echo "$info" | sed -n 's/^Filesystem volume name: *//p')" = omamobile-root ] || return 0
  blocks=$(echo "$info" | sed -n 's/^Block count: *//p')
  bsize=$(echo "$info" | sed -n 's/^Block size: *//p')
  part_bytes=$(blockdev --getsize64 "$dev" 2>/dev/null)
  [ -n "$blocks" ] && [ -n "$bsize" ] && [ -n "$part_bytes" ] || return 0
  fs_bytes=$((blocks * bsize))
  [ $((part_bytes - fs_bytes)) -gt 67108864 ] || return 0
  say "arch: growing the root file system to fill $dev ($((fs_bytes >> 20)) MiB to $((part_bytes >> 20)) MiB)"
  : > /run/omamobile-resizing
  e2fsck -f -p "$dev" >/dev/null 2>&1   # resize2fs wants a freshly checked file system
  if resize2fs "$dev" > /run/resize2fs.log 2>&1; then
    say "arch: root file system grown"
  else
    say "arch: resize2fs failed; booting at the old size"
    while read -r line; do echo "omamobile: resize2fs: $line" > /dev/kmsg; done < /run/resize2fs.log
  fi
  rm -f /run/omamobile-resizing
}

# Boot the Arch root from NFS instead of the UFS, for bring-up: nothing on the
# phone is written and the stock OS is left alone, so a root filesystem can be
# tried before anyone decides to install it. Enabled only by the presence of
# Root on an external USB disk, for local bring-up: /etc/omamobile-extroot holds
# an ext4 label; the guard leaves exactly that partition writable (see
# ufs_extroot_pass) and every UFS partition read-only. No file, no change.
boot_extroot() {
  local want p dev="" n i check open
  grep -q omamobile.initramfs /proc/cmdline && return 1
  read -r want 2>/dev/null < /etc/omamobile-extroot
  case "$want" in ''|*[!a-z0-9-]*) say "extroot: invalid label"; return 1 ;; esac
  say "extroot: waiting for an ext4 partition labelled $want on USB"
  # USB comes up with OTG, some seconds after boot: wait up to ~90 s
  i=0
  while [ $i -lt 90 ]; do
    ufs_ro_pass
    n=0
    for p in /sys/block/sd*/sd*; do
      [ -r "$p/ro" ] && ufs_usb_disk "${p##*/}" || continue
      [ "$(cat "$p/ro")" = 0 ] && ufs_extroot_marked "$p" "${p##*/}" || continue
      n=$((n + 1)); dev=/dev/${p##*/}
    done
    [ "$n" -gt 0 ] && break
    sleep 1; i=$((i + 1))
  done
  [ "$n" = 1 ] || { say "extroot: $n writable partitions labelled $want (need exactly one)"; return 1; }
  check=0
  e2fsck -p "$dev" >/dev/null 2>&1 || check=$?
  case $check in
    0|1) ;;
    *) say "extroot: check of $dev failed (status $check)"; return 1 ;;
  esac
  mkdir -p /newroot
  mount -t ext4 -o rw,relatime "$dev" /newroot || { say "extroot: cannot mount $dev"; return 1; }
  if [ ! -x /newroot/usr/lib/systemd/systemd ]; then
    say "extroot: no systemd on $dev"; umount /newroot; return 1
  fi
  ufs_ro_pass
  open=$(ufs_unguarded)
  if [ -n "$open" ]; then
    say "extroot: writable outside the external root: $(echo "$open" | tr "\n" " ")"
    umount /newroot
    return 1
  fi
  say "extroot: switching to Arch Linux on $dev"
  kill -9 -1 2>/dev/null
  sleep 1
  for m in /dev /proc /sys /run; do
    mkdir -p "/newroot$m" && mount --move "$m" "/newroot$m"
  done
  exec switch_root /newroot /usr/lib/systemd/systemd
}

# /etc/omamobile-nfsroot, holding one line, "<host>:<path>" -- no file, no change.
# The USB gadget and its address are already up by the time this runs, and the
# kernel keeps them across the switch, so the mount survives switch_root.
boot_nfs() {
  local spec
  grep -q omamobile.initramfs /proc/cmdline && return 1
  [ -r /etc/omamobile-nfsroot ] || return 1
  spec=$(cat /etc/omamobile-nfsroot)
  [ -n "$spec" ] || return 1
  say "nfsroot: trying $spec"
  mkdir -p /newroot
  # busybox mount cannot work out the server address on its own here, so pass it.
  # shortcut: IPv4 hosts only; add bracketed IPv6 parsing if a bring-up needs it.
  # Retry: the phone boots faster than the host brings its usb0 end up, so the
  # first mount can race the link coming up. ~30s covers a late host.
  local i=0
  until busybox mount -t nfs -o "nolock,vers=3,addr=${spec%%:*}" "$spec" /newroot 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -ge 15 ] && {
      say "nfsroot: cannot mount $spec (staying in the initramfs)"; return 1; }
    sleep 2
  done
  if [ ! -x /newroot/usr/lib/systemd/systemd ]; then
    say "nfsroot: no systemd on $spec"; umount /newroot; return 1
  fi
  # The first guard pass already used an empty allowlist in NFS mode.
  local open
  open=$(ufs_unguarded)
  if [ -n "$open" ]; then
    say "nfsroot: UFS remains writable: $(echo "$open" | tr "\n" " " ); staying in the initramfs"
    umount /newroot
    return 1
  fi
  say "nfsroot: switching to Arch Linux on $spec"
  # kill -9 -1 also stops the feeder; systemd takes over if the new root enables its watchdog.
  kill -9 -1 2>/dev/null
  sleep 1
  for m in /dev /proc /sys /run; do
    mkdir -p "/newroot$m" && mount --move "$m" "/newroot$m"
  done
  exec switch_root /newroot /usr/lib/systemd/systemd
}

# Keep a shell on the screen too
# Hand over to Arch on userdata, unless omamobile.initramfs is on the command
# line. Everything is checked before the irreversible exec; if anything is
# missing we stay here in the initramfs shell.
boot_arch() {
  grep -q omamobile.initramfs /proc/cmdline && return 1
  local dev="" s info label check
  for s in /sys/block/sda/sda*; do
    grep -qx PARTNAME=userdata "$s/uevent" 2>/dev/null && dev=/dev/${s##*/}
  done
  [ -n "$dev" ] || { say "arch: no userdata partition"; return 1; }
  [ "$(cat /sys/block/sda/${dev#/dev/}/ro)" = 0 ] || { say "arch: userdata is read-only"; return 1; }
  # Strict identification is opt-in: old hand-installed roots may be unlabelled.
  # The descriptor packs this file only when it requests the root protection.
  if [ -e /etc/omamobile-root-label ]; then
    label=$(cat /etc/omamobile-root-label)
    [ "$label" = omamobile-root ] || { say "arch: invalid root-label policy"; return 1; }
    info=$(dumpe2fs -h "$dev" 2>/dev/null) || { say "arch: userdata is not an ext4 root"; return 1; }
    [ "$(echo "$info" | sed -n 's/^Filesystem volume name: *//p')" = "$label" ] || {
      say "arch: userdata is not labelled $label"; return 1;
    }
  fi
  mkdir -p /newroot
  check=0
  e2fsck -p "$dev" >/dev/null 2>&1 || check=$?
  if [ -e /etc/omamobile-root-label ]; then
    case $check in
      0|1) ;;
      *) say "arch: root check failed (status $check); staying in the initramfs"; return 1 ;;
    esac
  fi
  # Keep the development filesystem at its image size until persistent boot
  # works. Growth can be done later from the installed system.
  if [ "$(cat /etc/omamobile-root-mode 2>/dev/null)" != persistent-development ]; then
    grow_root "$dev"
  fi
  mount -t ext4 -o rw,relatime "$dev" /newroot || { say "arch: cannot mount $dev"; return 1; }
  if [ ! -x /newroot/usr/lib/systemd/systemd ]; then
    say "arch: no systemd on $dev"; umount /newroot; return 1
  fi
  if [ "$(cat /etc/omamobile-root-mode 2>/dev/null)" = persistent-development ]; then
    # A failed development boot returns to the USB rescue environment after
    # reset. The installed SSH-ready service clears this marker on success.
    local pending=/newroot/var/lib/omamobile/root-boot-pending
    if [ -e "$pending" ]; then
      say "arch: previous development boot did not reach SSH; holding in RAM"
      umount /newroot
      return 1
    fi
  fi
  # The guard loop dies below and nothing in Arch sets a partition read-only,
  # so make one last pass and check, while SSH still runs: anything outside
  # the allowlist still writable (a late partition, a failed setro) keeps
  # the phone here.
  local open
  ufs_ro_pass
  open=$(ufs_unguarded)
  if [ -n "$open" ]; then
    say "arch: writable outside the allowlist: $(echo "$open" | tr "\n" " ")(staying in the initramfs)"
    umount /newroot
    return 1
  fi
  if [ "$(cat /etc/omamobile-root-mode 2>/dev/null)" = persistent-development ]; then
    # Record an attempted handover only after the final guard passes. A guard
    # refusal must not be reported as a root that failed to reach SSH next boot.
    mkdir -p /newroot/var/lib/omamobile || { umount /newroot; return 1; }
    cat /proc/sys/kernel/random/boot_id > "$pending" || { umount /newroot; return 1; }
    sync
  fi
  say "arch: switching to Arch Linux on $dev"
  # Stop the initramfs helpers (dropbear, getty, guards); the kernel keeps
  # the USB gadget and the partition read-only flags across the switch
  # systemd takes over the hardware watchdog here if the new root enables it.
  kill -9 -1 2>/dev/null
  sleep 1
  for m in /dev /proc /sys /run; do
    mkdir -p "/newroot$m" && mount --move "$m" "/newroot$m"
  done
  exec switch_root /newroot /usr/lib/systemd/systemd
}
# A descriptor selects development handover explicitly. An unknown mode never
# falls through into userdata. No mode file preserves the existing boot path.
boot_root() {
  if [ ! -e /etc/omamobile-root-mode ]; then
    boot_arch
    return $?
  fi
  case "$(cat /etc/omamobile-root-mode)" in
    persistent-development) boot_arch ;;
    ram-rescue) say "arch: RAM rescue selected"; return 1 ;;
    *) say "arch: unknown root mode; holding in RAM"; return 1 ;;
  esac
}
# A requested NFS root must not silently fall through to a writable UFS root.
if [ -s /etc/omamobile-nfsroot ]; then
  boot_nfs
  say "nfsroot: requested root unavailable (staying in the initramfs)"
elif [ -s /etc/omamobile-extroot ]; then
  boot_extroot
  say "extroot: requested root unavailable (staying in the initramfs)"
else
  boot_root
fi

# PID 1 must never exit: if it does the kernel panics and freezes (silently,
# since ABL sets console=null). So keep a shell on the screen in a loop
# instead of exec'ing one. setsid -c makes tty1 its controlling terminal
# (Alpine's busybox has no cttyhack; exec'ing it is what killed PID 1).
while true; do
  setsid -c sh </dev/tty1 >/dev/tty1 2>&1
  sleep 1
done
